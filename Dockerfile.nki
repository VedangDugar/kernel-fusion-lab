# AWS Neuron toolchain, for the NKI port of the fused kernel.
#
# Kept separate from the main CPU image because the Neuron compiler is large
# and unrelated to the Triton work. Nothing here needs Trainium hardware; the
# kernel is validated on NKI's CPU simulator.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /work

RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc g++ \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip \
 && pip install --index-url https://download.pytorch.org/whl/cpu torch \
 && pip install numpy pytest \
 && pip install --extra-index-url https://pip.repos.neuron.amazonaws.com \
      "neuronx-cc==2.26.*" "nki==0.5.*"

CMD ["bash"]
